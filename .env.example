# Required to create or manage a Bolna agent. Never commit the real value.
BOLNA_API_KEY=

# Public Render endpoint after deployment.
LOCATE_API_URL=https://YOUR-RENDER-APP.onrender.com/locate

# Shared secret used by Bolna when it calls the location API.
LOCATE_API_KEY=replace-with-a-long-random-secret

# Optional OpenStreetMap routing configuration.
OSRM_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
OSM_USER_AGENT=NITH-Wayfinder/1.0 (contact: your-email@example.com)
